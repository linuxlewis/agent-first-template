{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"paths": {
			"@domains/*": ["./src/domains/*"],
			"@providers/*": ["./src/providers/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		"tests/**/*.tsx",
		"scripts/**/*.ts",
		"lints/**/*.ts",
		"drizzle.config.ts",
		"playwright.config.ts",
		"vitest.config.ts"
	],
	"exclude": ["node_modules", "dist"]
}
